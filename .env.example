# CORS Origins (comma-separated; must include your production domain)
CORS_ORIGINS=https://zchat.space,https://www.zchat.space

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zchat
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend Configuration
JWT_SECRET=change_me_in_production
ENCRYPTION_KEY=change_me_must_be_32_bytes_long_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_TOKEN_EXPIRE_DAYS=30
MAX_MESSAGES_PER_CONVERSATION=1000

# Frontend Configuration
VITE_API_URL=/api
VITE_WS_URL=/ws

# Frontend container port (the only published port; point cloudflared at it,
# e.g. service: http://localhost:3000). Bound to localhost unless overridden.
FRONTEND_PORT=3000
FRONTEND_BIND=127.0.0.1

# Optional: root CA for Docker builds behind a TLS-intercepting proxy (e.g. Zscaler)
# EXTRA_CA_FILE=/usr/local/share/ca-certificates/zscaler-root.crt

# Web Push Notifications (optional — generate with webpush.GenerateVAPIDKeys())
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
